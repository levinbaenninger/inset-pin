{
  "name": "inset-context-pin",
  "version": "0.1.0",
  "private": true,
  "description": "Point-first thought capture utility for the Inset capture experiment.",
  "license": "UNLICENSED",
  "author": "Levin Bänninger",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "icons": "node scripts/generate-icons.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@resvg/resvg-js": "^2.6.2",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Inset Context Pin"
}
